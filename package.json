{
  "name": "slotly",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @slotly/db generate",
    "db:migrate": "pnpm --filter @slotly/db migrate",
    "db:studio": "pnpm --filter @slotly/db studio"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8"
  },

  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.38.4"
    }
  }
}
